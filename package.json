{
 "name": "worklink",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "scripts": {
  "dev": "vite --mode customer",
  "dev:worker": "vite --mode worker --port 5174",
  "build:customer": "vite build --mode customer",
  "build:worker": "vite build --mode worker --outDir dist/worker --emptyOutDir false",
  "build": "tsc -b && npm run build:customer && npm run build:worker",
  "preview": "vite preview"
 },
 "dependencies": {
  "@supabase/supabase-js": "^2.45.0",
  "lucide-react": "^0.453.0",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "react-router-dom": "^6.28.0"
 },
 "devDependencies": {
  "@tailwindcss/vite": "^4.0.0",
  "@types/react": "^18.3.12",
  "@types/react-dom": "^18.3.1",
  "@vitejs/plugin-react": "^4.3.3",
  "tailwindcss": "^4.0.0",
  "typescript": "~5.6.2",
  "vite": "^6.0.0"
 }
}